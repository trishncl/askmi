rules_version = '2';

// PHASE 1 baseline. Deploy this before writing a single screen — see the
// project roadmap: every collection requires sign-in, and the `users`
// collection additionally restricts who can create/delete accounts.
//
// KNOWN GAP, intentionally deferred to PHASE 6 (hardening pass): none of
// these rules yet check that a Manager/Cashier's own `branch` matches the
// document's `branch` field. Right now any authenticated user can read/
// write any branch's sales/inventory/products/menuItems. Do not consider
// this "secured" until Phase 6 adds that check.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Owner';
    }

    // users: create/delete restricted to Owner (checked via isOwner() above).
    // Account creation happens client-side via a temporary secondary
    // Firebase app (see services/staff_account_service.dart, Phase 2) —
    // no Cloud Function, no Blaze plan needed.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow create, delete: if isOwner();
    }

    // Everything else: signed-in required. Branch scoping is Phase 6 work.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
